    <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="4" BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="4" SnapsToDevicePixels="True"><TextBlock Text="completed shuttles" Style="{StaticResource Tx}" Margin="2" VerticalAlignment="Center"/></Border>

    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#222222" BorderThickness="0,0,1,1" Padding="4" SnapsToDevicePixels="True"><TextBox x:Name="TotalShuttlesBox" Style="{StaticResource CellInput}" IsReadOnly="True" Margin="2"/></Border>
    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#222222" BorderThickness="0,0,1,1" Padding="4" SnapsToDevicePixels="True"><TextBlock Text="total shuttles" Style="{StaticResource Tx}" Margin="2" VerticalAlignment="Center"/></Border>
