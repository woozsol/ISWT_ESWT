<Window UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="ISWT.ResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ISWT 최종 리포트" Width="900" Height="1969" MinWidth="780" MinHeight="700" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Malgun Gothic">
<Window.Resources>
 <Style x:Key="In" TargetType="TextBox">
  <Setter Property="Height" Value="27"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="#4B5563"/>
  <Setter Property="Background" Value="White"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
  <Setter Property="Margin" Value="3,2"/>
  <Setter Property="Padding" Value="3,1"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="#101828"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="TextAlignment" Value="Right"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="1.5"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxBorder" Property="Background" Value="#F3F4F6"/><Setter Property="Foreground" Value="#6B7280"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="CellInput" TargetType="TextBox" BasedOn="{StaticResource In}">
  <!-- 셀 안 입력칸의 상/하/좌/우 테두리를 명시적으로 표시 -->
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="#667085"/>
  <Setter Property="Background" Value="White"/>
  <Setter Property="Margin" Value="3,2"/>
  <Setter Property="Padding" Value="4,1"/>
  <Setter Property="Height" Value="26"/>
  <Setter Property="MinWidth" Value="45"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
 </Style>
 <Style x:Key="Tx" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#111827"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,2"/></Style>
 <Style x:Key="Bd" TargetType="Border"><Setter Property="BorderBrush" Value="#222222"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="Padding" Value="3"/></Style>
</Window.Resources>
<DockPanel Margin="16">
 <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
  <Button Content="결과 저장" Width="105" Height="34" Margin="3" Click="SaveButton_Click" Background="#2563EB" Foreground="White" FontWeight="Bold"/><Button Content="인쇄" Width="75" Height="34" Margin="3" Click="PrintButton_Click"/><Button Content="닫기" Width="75" Height="34" Margin="3" Click="CloseButton_Click"/>
 </StackPanel>
 <ScrollViewer x:Name="ReportScrollViewer" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ReportContent" HorizontalAlignment="Stretch">
  <Border BorderBrush="#1D4ED8" BorderThickness="1.5" CornerRadius="6" Background="#F3F7FF" Padding="10" Margin="0,0,0,8">
   <StackPanel>
    <TextBlock Text="환자 기본 정보" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" Margin="2,0,2,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Grid.Column="0" BorderBrush="#344054" BorderThickness="1" Padding="6,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="이름" FontWeight="Bold" VerticalAlignment="Center" Margin="2"/><TextBlock x:Name="PatientNameValue" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" FontSize="13"/></Grid></Border>
     <Border Grid.Row="0" Grid.Column="1" BorderBrush="#344054" BorderThickness="1" Padding="6,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="등록번호" FontWeight="Bold" VerticalAlignment="Center" Margin="2"/><TextBlock x:Name="PatientRegValue" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" FontSize="13"/></Grid></Border>
     <Border Grid.Row="0" Grid.Column="2" BorderBrush="#344054" BorderThickness="1" Padding="6,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="키" FontWeight="Bold" VerticalAlignment="Center" Margin="2"/><TextBlock x:Name="PatientHeightValue" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" FontSize="13"/></Grid></Border>
     <Border Grid.Row="1" Grid.Column="0" BorderBrush="#344054" BorderThickness="1" Padding="6,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="몸무게" FontWeight="Bold" VerticalAlignment="Center" Margin="2"/><TextBlock x:Name="PatientWeightValue" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" FontSize="13"/></Grid></Border>
     <Border Grid.Row="1" Grid.Column="1" BorderBrush="#344054" BorderThickness="1" Padding="6,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="나이" FontWeight="Bold" VerticalAlignment="Center" Margin="2"/><TextBlock x:Name="PatientAgeValue" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" FontSize="13"/></Grid></Border>
     <Border Grid.Row="1" Grid.Column="2" BorderBrush="#344054" BorderThickness="1" Padding="6,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="생년월일" FontWeight="Bold" VerticalAlignment="Center" Margin="2"/><TextBox x:Name="BirthDateBox" Grid.Column="1" Height="25" Margin="2,0" Padding="3,1" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalContentAlignment="Center" BorderBrush="#98A2B3" ToolTip="예: 1963-04-15"/></Grid></Border>
    </Grid>
   </StackPanel>
  </Border>
  <Border BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True" Padding="7" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Resting SpO₂" Style="{StaticResource Tx}" FontWeight="Bold"/><TextBlock x:Name="RestingSpo2ResultText" Grid.Column="1" Style="{StaticResource Tx}"/><TextBlock Text="Resting HR" Grid.Column="2" Style="{StaticResource Tx}" FontWeight="Bold"/><TextBlock x:Name="RestingHrResultText" Grid.Column="3" Style="{StaticResource Tx}"/><TextBlock Text="Resting BP" Grid.Column="4" Style="{StaticResource Tx}" FontWeight="Bold"/><TextBlock x:Name="RestingBpResultText" Grid.Column="5" Style="{StaticResource Tx}"/></Grid></Border>
  <TextBlock Text="호흡 곤란 내용(mMRC dyspnea scale)" FontSize="15" FontWeight="Bold" Foreground="#101828" Margin="0,0,0,5"/>
  <StackPanel x:Name="MmrcPanel">
   <RadioButton x:Name="Mmrc0" Content="0 힘든 운동을 할 때만 숨이 차다." GroupName="MMRC" Margin="3,3" FontSize="13" Foreground="#101828"/>
   <RadioButton x:Name="Mmrc1" Content="1 평지를 빨리 걷거나, 약간 오르막길을 걸을 때 숨이 차다." GroupName="MMRC" Margin="3,3" FontSize="13" Foreground="#101828"/>
   <RadioButton x:Name="Mmrc2" Content="2 평지를 걸을 때 숨이 차서 동년배보다 천천히 걷거나, 자신의 속도로 걸어도 숨이 차서 멈추어 쉬어야 한다." GroupName="MMRC" Margin="3,3" FontSize="13" Foreground="#101828"/>
   <RadioButton x:Name="Mmrc3" Content="3 평지를 약 100m 정도 걷거나, 몇 분 동안 걸으면 숨이 차서 멈추어 쉬어야 한다." GroupName="MMRC" Margin="3,3" FontSize="13" Foreground="#101828"/>
   <RadioButton x:Name="Mmrc4" Content="4 숨이 너무 차서 집을 나설 수 없거나, 옷을 입거나 벗을 때도 숨이 차다." GroupName="MMRC" Margin="3,3" FontSize="13" Foreground="#101828"/>
  </StackPanel>
  <Grid Margin="0,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="산소 흡입" Style="{StaticResource Tx}"/><TextBox x:Name="OxygenBox" Grid.Column="1" Style="{StaticResource In}"/><TextBlock Grid.Column="2" Text="L/min" Style="{StaticResource Tx}"/>
   <TextBlock Grid.Row="1" Text="분당 호흡수" Style="{StaticResource Tx}"/><TextBox x:Name="RespRateBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource In}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="회/분" Style="{StaticResource Tx}"/>
   <TextBlock Grid.Row="2" Text="예측 최대 심박수(predict max HR)" Style="{StaticResource Tx}"/><TextBox x:Name="PredictedHrBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource In}" IsReadOnly="True"/><TextBlock Grid.Row="2" Grid.Column="2" Text="회/분" Style="{StaticResource Tx}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="85% target HR =" Style="{StaticResource Tx}"/><TextBox x:Name="TargetHrBox" Grid.Row="2" Grid.Column="4" Style="{StaticResource In}" IsReadOnly="True"/><TextBlock Grid.Row="2" Grid.Column="5" Text="회/분" Style="{StaticResource Tx}"/>
   <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="#667085" BorderThickness="1" Background="#F8FAFC" CornerRadius="3" Padding="5,2" Margin="0,1,0,2" HorizontalAlignment="Left"><TextBlock Text="예측 최대 심박수 = 210 - (age x 0.65)" Style="{StaticResource Tx}" FontSize="14" Foreground="#344054" VerticalAlignment="Center"/></Border><TextBlock Grid.Row="4" Text="검사 중단 사유" Style="{StaticResource Tx}" Margin="4,5"/><StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="6" Margin="3">
    <CheckBox x:Name="StopDyspnea" Content="호흡 곤란 호소" Margin="2"/><CheckBox x:Name="StopSpO2" Content="환자의 산소 포화도가 80% 이하로 감소" Margin="2"/><CheckBox x:Name="StopLeg" Content="근골격계 문제" Margin="2"/><CheckBox x:Name="StopTargetHr" Content="target HR 초과" Margin="2"/><StackPanel Orientation="Horizontal" Margin="2" VerticalAlignment="Center"><CheckBox x:Name="StopOther" Content="기타" VerticalAlignment="Center"/><TextBox x:Name="StopOtherBox" Style="{StaticResource In}" Width="400" VerticalAlignment="Center" Margin="6,0,3,0"/></StackPanel>
   </StackPanel>
  </Grid>
  <Grid Margin="0,2,0,5" Height="30" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="추가 보행 가능 여부" Style="{StaticResource Tx}" VerticalAlignment="Center"/><RadioButton x:Name="FurtherYes" Grid.Column="1" Content="예" GroupName="Further" Margin="12,0,8,0" VerticalAlignment="Center"/><RadioButton x:Name="FurtherNo" Grid.Column="2" Content="아니오" GroupName="Further" Margin="12,0,8,0" VerticalAlignment="Center"/></Grid>
  <Grid Margin="0,2,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="47"/><RowDefinition Height="47"/><RowDefinition Height="47"/><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Grid.Column="0" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"/><Border Grid.Row="0" Grid.Column="1" BorderBrush="#333" BorderThickness="1,1,1,1"><TextBlock Text="검사 전" Style="{StaticResource Tx}" HorizontalAlignment="Center"/></Border><Border Grid.Row="0" Grid.Column="2" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="검사 직후" Style="{StaticResource Tx}" HorizontalAlignment="Center"/></Border><Border Grid.Row="0" Grid.Column="3" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="검사 1분 후" Style="{StaticResource Tx}" HorizontalAlignment="Center"/></Border>
   <Border Grid.Row="1" Grid.Column="0" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="BP" Style="{StaticResource Tx}"/></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="BpBefore" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="mmHg" Style="{StaticResource Tx}"/></StackPanel></Border><Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="BpAfter" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="mmHg" Style="{StaticResource Tx}"/></StackPanel></Border><Border Grid.Row="1" Grid.Column="3" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="BpMinute" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="mmHg" Style="{StaticResource Tx}"/></StackPanel></Border>
   <Border Grid.Row="2" Grid.Column="0" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="HR" Style="{StaticResource Tx}"/></Border><Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="HrBefore" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="회/분" Style="{StaticResource Tx}"/></StackPanel></Border><Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="HrAfter" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="회/분" Style="{StaticResource Tx}"/></StackPanel></Border><Border Grid.Row="2" Grid.Column="3" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="HrMinute" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="회/분" Style="{StaticResource Tx}"/></StackPanel></Border>
   <Border Grid.Row="3" Grid.Column="0" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="SpO2" Style="{StaticResource Tx}"/></Border><Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="Spo2Before" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="%" Style="{StaticResource Tx}"/></StackPanel></Border><Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="Spo2After" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="%" Style="{StaticResource Tx}"/></StackPanel></Border><Border Grid.Row="3" Grid.Column="3" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="Spo2Minute" Style="{StaticResource CellInput}" Width="95" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="%" Style="{StaticResource Tx}"/></StackPanel></Border>
   <Border Grid.Row="4" Grid.Column="0" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="호흡 곤란 Borg Scale" Style="{StaticResource Tx}" TextWrapping="Wrap"/></Border><Border Grid.Row="4" Grid.Column="1" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="DyspneaBefore" Style="{StaticResource CellInput}" Width="110"/></StackPanel></Border><Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="DyspneaAfter" Style="{StaticResource CellInput}" Width="110"/></StackPanel></Border><Border Grid.Row="4" Grid.Column="3" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="DyspneaMinute" Style="{StaticResource CellInput}" Width="110"/></StackPanel></Border>
   <Border Grid.Row="5" Grid.Column="0" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="하지 피로도 Borg Scale" Style="{StaticResource Tx}" TextWrapping="Wrap"/></Border><Border Grid.Row="5" Grid.Column="1" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="LegBefore" Style="{StaticResource CellInput}" Width="110"/></StackPanel></Border><Border Grid.Row="5" Grid.Column="2" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="LegAfter" Style="{StaticResource CellInput}" Width="110"/></StackPanel></Border><Border Grid.Row="5" Grid.Column="3" Style="{StaticResource Bd}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="43,0,0,0"><TextBox x:Name="LegMinute" Style="{StaticResource CellInput}" Width="110"/></StackPanel></Border>
   <Border Grid.Row="6" Grid.Column="0" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="HR 회복 시간" Style="{StaticResource Tx}"/></Border><Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="47,0,0,0"><TextBox x:Name="RecoveryTimeBox" Style="{StaticResource CellInput}" Width="105"/><TextBlock Text="*기준: 검사 전 +5회/분" Style="{StaticResource Tx}"/></StackPanel></Border>
  </Grid>
  <Border Background="#F0F0F0" Padding="5,3" Margin="0,4,0,3">
   <TextBlock Text="ISWT" FontSize="13" FontWeight="Bold" Foreground="#111827"/>
  </Border>
  <Border BorderBrush="#222222" BorderThickness="1" Padding="0" Margin="3,0,3,5" SnapsToDevicePixels="True">
   <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="140"/>
     <ColumnDefinition Width="72"/>
     <ColumnDefinition Width="125"/>
     <ColumnDefinition Width="72"/>
     <ColumnDefinition Width="125"/>
     <ColumnDefinition Width="72"/>
     <ColumnDefinition Width="90"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="39"/>
     <RowDefinition Height="39"/>
     <RowDefinition Height="39"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="#222222" BorderThickness="0,0,1,1" Background="#FFFFFF" Padding="5" SnapsToDevicePixels="True">
     <TextBlock Text="총 보행 거리" Style="{StaticResource Tx}" Margin="0" VerticalAlignment="Center"/>
    </Border>
    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#222222" BorderThickness="0,0,1,1" Padding="4" SnapsToDevicePixels="True"><TextBox x:Name="CompletedLevelsBox" Style="{StaticResource CellInput}" IsReadOnly="True" Margin="2"/></Border>
    <Border Grid.Row="0" Grid.Column="2" BorderBrush="#222222" BorderThickness="0,0,1,1" Padding="4" SnapsToDevicePixels="True"><TextBlock Text="completed levels" Style="{StaticResource Tx}" Margin="2" VerticalAlignment="Center"/></Border>
