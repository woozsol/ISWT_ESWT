<Window x:Class="ISWT.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ISWT 보행 검사" Width="1100" Height="830" MinWidth="900" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Inp" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#101828"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#98A2B3"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="Act" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="TestRoot" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ISWT 보행 검사" FontSize="28" FontWeight="Bold" Foreground="#101828"/>
                    <TextBlock Text="Incremental Shuttle Walk Test" Foreground="#667085" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E8F7EE" CornerRadius="18" Padding="16,8" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="검사 준비" Foreground="#16794B" FontWeight="Bold"/>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="4,0,10,0">
                        <TextBlock Text="환자 이름" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="PatientName" Style="{StaticResource Inp}" MaxLength="50"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,10,0">
                        <TextBlock Text="등록번호 (숫자 8자리)" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="PatientRegistration" Style="{StaticResource Inp}" MaxLength="8" PreviewTextInput="Registration_PreviewTextInput" DataObject.Pasting="Registration_Pasting"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,10,0">
                        <TextBlock Text="키 (cm)" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="PatientHeight" Style="{StaticResource Inp}" MaxLength="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0,10,0">
                        <TextBlock Text="몸무게 (kg)" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="PatientWeight" Style="{StaticResource Inp}" MaxLength="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="4,0,0,0">
                        <TextBlock Text="나이" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="PatientAge" Style="{StaticResource Inp}" MaxLength="3" TextChanged="PatientAge_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="#EAF2FF" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="예측 최대 심박수: " Foreground="#344054" FontSize="14"/>
                    <TextBlock x:Name="PredictedHrText" Text="-- 회/분" FontWeight="Bold" Foreground="#1D4ED8" FontSize="14" Margin="0,0,24,0"/>
                    <TextBlock Text="85% Target HR: " Foreground="#344054" FontSize="14"/>
                    <TextBlock x:Name="TargetHrText" Text="-- 회/분" FontWeight="Bold" Foreground="#1D4ED8" FontSize="14"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,9,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="다음 셔틀까지 남은 시간" FontSize="17" FontWeight="SemiBold" Foreground="#344054" HorizontalAlignment="Center"/>
                        <Grid Grid.Row="1" Width="290" Height="290" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Stroke="#E7ECF3" StrokeThickness="16"/>
                            <Path x:Name="GaugeArc" Stroke="#3B82F6" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CountdownText" Text="20" FontSize="76" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center"/>
                                <TextBlock Text="초" FontSize="19" Foreground="#667085" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock x:Name="LevelText" Text="1단계" FontSize="25" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SpeedText" Text="권장 속도 1.8 km/h" FontSize="16" Foreground="#667085" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="9,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="총 보행 시간" FontSize="15" FontWeight="SemiBold" Foreground="#344054"/>
                                <TextBlock x:Name="TimerText" Text="00:00" FontSize="40" FontWeight="Bold" Foreground="#101828" Margin="0,6,0,0"/>
                                <TextBlock Text="검사 시작부터 누적된 시간" FontSize="12" Foreground="#667085"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#D0D5DD" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Resting SpO₂ (%)" FontSize="14" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,7"/>
                                    <TextBox x:Name="RestingSpo2Box" Height="36" FontSize="17" Foreground="#101828" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#98A2B3"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="현재 단계 셔틀" FontSize="15" FontWeight="SemiBold" Foreground="#344054"/>
                                <TextBlock x:Name="LevelShuttleText" Text="0/3" FontSize="36" FontWeight="Bold" Foreground="#101828" Margin="0,6,0,0"/>
                                <TextBlock Text="현재 단계에서 수행한 셔틀" FontSize="12" Foreground="#667085"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#D0D5DD" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Resting HR (회/분)" FontSize="14" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,7"/>
                                    <TextBox x:Name="RestingHrBox" Height="36" FontSize="17" Foreground="#101828" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#98A2B3"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="누적 셔틀 · 총 보행 거리" FontSize="15" FontWeight="SemiBold" Foreground="#344054"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="ShuttleText" Text="0회" FontSize="30" FontWeight="Bold" Foreground="#101828"/>
                                    <TextBlock Text=" · " FontSize="23" Foreground="#667085"/>
                                    <TextBlock x:Name="DistanceText" Text="0 m" FontSize="27" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                                <TextBlock Text="셔틀 1회당 10 m 기준" FontSize="12" Foreground="#667085"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#D0D5DD" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Resting BP (mmHg)" FontSize="14" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RestingSystolicBox" Height="36" FontSize="17" Foreground="#101828" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#98A2B3"/>
                                        <TextBlock Grid.Column="1" Text=" / " VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#344054"/>
                                        <TextBox x:Name="RestingDiastolicBox" Grid.Column="2" Height="36" FontSize="17" Foreground="#101828" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#98A2B3"/>
                                    </Grid>
                                    <TextBlock Text="수축기 / 이완기" FontSize="11" Foreground="#667085" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Content="검사 시작" Style="{StaticResource Act}" Background="#2563EB" Click="StartButton_Click"/>
                <Button x:Name="PauseButton" Grid.Column="1" Content="일시 정지" Style="{StaticResource Act}" Background="#667085" IsEnabled="False" Click="PauseButton_Click"/>
                <Button x:Name="StopButton" Grid.Column="2" Content="검사 중지" Style="{StaticResource Act}" Background="#DC2626" IsEnabled="False" Click="StopButton_Click"/>
            </Grid>
        </Grid>

        <Border x:Name="EntryOverlay" Panel.ZIndex="100" Background="#F3F6FA" Padding="24" Margin="0,0,0,-152">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Center">
                    <TextBlock Text="Shuttle Walking Test 전 환자 기본 정보 입력" FontSize="28" FontWeight="Bold" Foreground="#101828" Margin="0,0,0,4"/>
                    <TextBlock Text="환자 정보와 안정 시 측정값을 입력해 주세요." FontSize="14" Foreground="#667085" Margin="0,0,0,16"/>
                    <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="환자 기본정보" FontSize="18" FontWeight="Bold" Foreground="#1D2939" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="142*"/>
                                    <ColumnDefinition Width="138*"/>
                                    <ColumnDefinition Width="91*"/>
                                    <ColumnDefinition Width="91*"/>
                                    <ColumnDefinition Width="157*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4,4,4,4">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"><Run Language="ko-kr" Text="        "/><Run Text="환자 이름"/></TextBlock>
                                    <TextBox x:Name="EntryPatientName" Height="40" FontSize="16" Padding="8" Text="" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,4,4,4">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"><Run Language="ko-kr" Text=" "/><Run Text="등록번호 (숫자 8자리)"/></TextBlock>
                                    <TextBox x:Name="EntryPatientRegistration" Height="40" FontSize="16" Padding="8" MaxLength="8" PreviewTextInput="Registration_PreviewTextInput" DataObject.Pasting="Registration_Pasting" Text=""/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,4,4,4">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"><Run Language="ko-kr" Text="    "/><Run Text="키 (cm)"/></TextBlock>
                                    <TextBox x:Name="EntryPatientHeight" Height="40" FontSize="16" Padding="8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,4,4,4">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"><Run Language="ko-kr" Text="  "/><Run Text="몸무게 (kg)"/></TextBlock>
                                    <TextBox x:Name="EntryPatientWeight" Height="40" FontSize="16" Padding="8" Text=""/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="4,4,4,4">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"><Run Language="ko-kr" Text=" "/><Run Text="생년월일"/><Run Text=" ("/><Run Text="YYYY/MM/DD"/><Run Text=")"/></TextBlock>
                                    <TextBox x:Name="EntryPatientAge" Height="40" FontSize="16" Padding="8" MaxLength="14" ToolTip="예: 1975 / 01 / 13" PreviewKeyDown="EntryPatientAge_PreviewKeyDown"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="안정 시 측정값 (Resting)" FontSize="18" FontWeight="Bold" Foreground="#1D2939" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"><Run Language="ko-kr" Text="         "/><Run Text="Resting SpO₂ (%)"/></TextBlock>
                                    <TextBox x:Name="EntryRestingSpo2" Height="40" FontSize="16" Padding="8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4">
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5"><Run Language="ko-kr" Text="        "/><Run Text="Resting HR (회/분)"/></TextBlock>
                                    <TextBox x:Name="EntryRestingHr" Height="40" FontSize="16" Padding="8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="Resting BP (mmHg)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="EntryRestingSystolic" Height="40" FontSize="16" Padding="8"/>
                                        <TextBlock Grid.Column="1" Text="/" FontSize="20" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBox x:Name="EntryRestingDiastolic" Grid.Column="2" Height="40" FontSize="16" Padding="8"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="검사 전 평가" FontSize="18" FontWeight="Bold" Foreground="#1D2939" Margin="0,0,0,10"/>
                            <TextBlock Text="호흡 곤란 내용 (mMRC dyspnea scale)" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                            <UniformGrid Columns="1">
                                <RadioButton x:Name="EntryMmrc0" GroupName="EntryMMRC" Content="0  힘든 운동을 할 때만 숨이 차다." Margin="3" FontSize="14"/>
                                <RadioButton x:Name="EntryMmrc1" GroupName="EntryMMRC" Content="1  평지를 빨리 걷거나, 약간 오르막길을 걸을 때 숨이 차다." Margin="3" FontSize="14"/>
                                <RadioButton x:Name="EntryMmrc2" GroupName="EntryMMRC" Content="2  평지를 걸을 때 숨이 차서 동년배보다 천천히 걷거나, 멈추어 쉬어야 한다." Margin="3" FontSize="14"/>
                                <RadioButton x:Name="EntryMmrc3" GroupName="EntryMMRC" Content="3  평지를 약 100m 정도 걷거나 몇 분 동안 걸으면 숨이 차서 쉬어야 한다." Margin="3" FontSize="14"/>
                                <RadioButton x:Name="EntryMmrc4" GroupName="EntryMMRC" Content="4  숨이 너무 차서 집을 나설 수 없거나 옷을 입고 벗을 때도 숨이 차다." Margin="3" FontSize="14"/>
                            </UniformGrid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto" MinWidth="97"/>
                                    <ColumnDefinition Width="75.963"/>
                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                    <ColumnDefinition Width="77"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="산소 흡입" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,4,0" Height="16"/>
                                <TextBox x:Name="EntryOxygen" Grid.Column="1" FontSize="15" Padding="6"/>
                                <TextBlock Text="L/min" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,6,0" Height="16"/>
                                <TextBlock Text="분당 호흡수" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,4,0" Height="16"/>
                                <TextBox x:Name="EntryRespRate" Grid.Column="4" FontSize="15" Padding="6"/>
                                <TextBlock Text="회/분" Grid.Column="5" VerticalAlignment="Center" Margin="6,0,6,0" Height="16"/>
                            </Grid>
                            <Border Background="#EEF4FF" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="심박수 예측 계산" FontSize="15" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="예측 최대 심박수" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="EntryPredictedHr" Text="-- 회/분" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Margin="10,0,22,0"/>
                                        <TextBlock Text="85% 목표 심박수" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="EntryTargetHr" Text="-- 회/분" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Margin="10,0,0,0"/>
                                    </WrapPanel>
                                    <TextBlock Text="예측 최대 심박수 = 210 − (나이 × 0.65)     |     85% 목표 심박수 = 예측 최대 심박수 × 0.85" FontSize="14" Foreground="#344054" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,14,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="ISWT 검사 시작" Click="StartEntry_Click" Height="54" Margin="4,0,8,0" Background="#2563EB" Foreground="White" FontSize="17" FontWeight="Bold" BorderThickness="0"/>
                        <Button Grid.Column="1" Content="ESWT 검사 시작" Click="StartEswtEntry_Click" Height="54" Margin="8,0,4,0" Background="#0F766E" Foreground="White" FontSize="17" FontWeight="Bold" BorderThickness="0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
